---
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<section class="tool-faq">
  <h2>Questions</h2>
  {
    faqs.map(({ q, a }) => (
      <details>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))
  }
</section>

<style>
  .tool-faq {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--color-line);
  }

  h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-serif);
    font-size: var(--size-lg);
  }

  details {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  details:last-child {
    border-bottom: none;
  }

  summary {
    font-family: var(--font-serif);
    font-size: var(--size-base);
    font-weight: 600;
    cursor: pointer;
  }

  details p {
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: var(--size-sm);
    line-height: 1.6;
  }
</style>
