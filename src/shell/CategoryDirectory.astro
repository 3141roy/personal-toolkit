---
import ToolGrid from './ToolGrid.astro';
import { byCategory } from '../tools/registry';
import { categories } from '../config/site';
---

{
  categories.map((category) => {
    const catTools = byCategory(category.id);
    const cap = 8;
    const shown = catTools.slice(0, cap);
    const overflow = catTools.length - shown.length;
    return (
      <section class="category">
        <div class="category-head">
          <div class="category-head-main">
            <a class="category-link" href={`/${category.id}`}>
              <h2>{category.label}</h2>
            </a>
            <span class="count">
              {catTools.length === 0
                ? 'coming soon'
                : `${catTools.length} tool${catTools.length !== 1 ? 's' : ''}`}
            </span>
          </div>
          {overflow > 0 && (
            <a class="see-all" href={`/${category.id}`}>
              See all {catTools.length} →
            </a>
          )}
        </div>
        {catTools.length === 0 ? (
          <p class="empty">Nothing here yet.</p>
        ) : (
          <ToolGrid tools={shown} />
        )}
      </section>
    );
  })
}

<footer class="directory-footer">
  <p>built by someone who hates sketchy upload buttons</p>
</footer>

<style>
  .category {
    padding: 1.8rem 0;
  }

  .category-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .category-head-main {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .category-link {
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid transparent;
  }

  .category-link:hover {
    border-bottom-color: var(--color-oxblood);
  }

  .category-link:hover h2 {
    color: var(--color-oxblood);
  }

  .category-head h2 {
    font-size: var(--size-lg);
  }

  .category-head .count {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--color-muted);
  }

  .see-all {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--color-oxblood);
    text-decoration: none;
    white-space: nowrap;
  }

  .see-all:hover {
    text-decoration: underline;
  }

  .empty {
    font-size: var(--size-sm);
    color: var(--color-muted);
    font-style: italic;
  }

  .directory-footer {
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--color-line);
  }

  .directory-footer p {
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--color-ink-navy);
    margin: 0;
  }
</style>
