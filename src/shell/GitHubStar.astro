---
import { siteName } from '../config/site';

const repoUrl = 'https://github.com/3141roy/personal-toolkit';
---

<a
  href={repoUrl}
  class="gh-star"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Star ${siteName} on GitHub`}
  title={`Star ${siteName} on GitHub`}
>
  <span class="flipper">
    <svg class="face face-mark" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
      ></path>
    </svg>
    <svg class="face face-star" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
      <path d="M8 .9l2.2 4.5 5 .73-3.6 3.5.85 4.97L8 12.25 3.55 14.6l.85-4.97L.8 6.13l5-.73z"
      ></path>
    </svg>
  </span>
</a>

<style>
  .gh-star {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .gh-star:hover,
  .gh-star:focus-visible {
    border-color: var(--color-oxblood);
    color: var(--color-oxblood);
  }

  .flipper {
    position: relative;
    width: 17px;
    height: 17px;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.4, 0.1, 0.2, 1);
  }

  .gh-star:hover .flipper,
  .gh-star:focus-visible .flipper {
    transform: rotateY(360deg);
  }

  .face {
    position: absolute;
    inset: 0;
    width: 17px;
    height: 17px;
    backface-visibility: hidden;
  }

  .face-star {
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.25s 0.12s,
      transform 0.25s 0.12s,
      filter 0.25s;
  }

  .gh-star:hover .face-star,
  .gh-star:focus-visible .face-star {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(0 0 5px var(--color-oxblood));
  }

  .gh-star:hover .face-mark,
  .gh-star:focus-visible .face-mark {
    opacity: 0;
    transition: opacity 0.2s 0.12s;
  }

  @media (prefers-reduced-motion: reduce) {
    .flipper,
    .face {
      transition-duration: 0.01ms;
    }

    .gh-star:hover .flipper,
    .gh-star:focus-visible .flipper {
      transform: none;
    }
  }
</style>
