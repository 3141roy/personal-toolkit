---
import { supportEmail, siteName } from '../config/site';

const subject = encodeURIComponent(`${siteName} — bug report`);
const body = encodeURIComponent(`What happened:\n\n\nPage: ${Astro.url.pathname}\n`);
const href = `mailto:${supportEmail}?subject=${subject}&body=${body}`;
---

<a href={href} class="report-bug" aria-label="Report a bug">
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v18M5 4h11l-2.5 3.5L16 11H5" />
  </svg>
</a>

<style>
  .report-bug {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }

  .report-bug:hover {
    border-color: var(--color-oxblood);
    color: var(--color-oxblood);
  }

  .icon {
    width: 17px;
    height: 17px;
  }
</style>
