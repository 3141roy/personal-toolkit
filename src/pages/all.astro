---
import AppLayout from '../layouts/AppLayout.astro';
import CategoryDirectory from '../shell/CategoryDirectory.astro';
import { tools } from '../tools/registry';
import { siteName } from '../config/site';
---

<AppLayout
  title={`All Tools - Private PDF, Image, Dev, Text and Generate | ${siteName}`}
  description={`Every ${siteName} tool in one list. Free PDF, image, dev, text and generator tools that run entirely in your browser. Nothing is uploaded, nothing leaves your device.`}
  activeCategory="all"
>
  <Fragment slot="intro">
    <h1>All tools</h1>
    <p>{tools.length} tool{tools.length !== 1 ? 's' : ''} across every category.</p>
  </Fragment>
  <CategoryDirectory />
</AppLayout>
