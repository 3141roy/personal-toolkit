---
import AppLayout from '../../layouts/AppLayout.astro';
import ToolLoader from '../../shell/ToolLoader.svelte';
import { tools } from '../../tools/registry';
import { siteName } from '../../config/site';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { category: tool.category, tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
---

<AppLayout title={`${tool.name} — ${siteName}`} activeCategory={tool.category}>
  <Fragment slot="intro">
    <h1>{tool.name}</h1>
    <p>{tool.summary}</p>
  </Fragment>
  <ToolLoader toolId={tool.id} client:load />
</AppLayout>
