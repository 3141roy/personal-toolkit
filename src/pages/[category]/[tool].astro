---
import AppLayout from '../../layouts/AppLayout.astro';
import ToolLoader from '../../shell/ToolLoader.svelte';
import ToolFaq from '../../shell/ToolFaq.astro';
import { tools } from '../../tools/registry';
import { siteName, siteUrl, categories, sharedFaq } from '../../config/site';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { category: tool.category, tool: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const categoryLabel = categories.find((c) => c.id === tool.category)?.label ?? tool.category;
const toolUrl = `${siteUrl}/${tool.category}/${tool.id}`;
const faq = [...(tool.faq ?? []), ...(tool.sharedFaq === false ? [] : sharedFaq)];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: tool.name,
      description: tool.summary,
      url: toolUrl,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://github.com/3141roy/personal-toolkit/blob/main/LICENSE',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: siteName, item: siteUrl },
        {
          '@type': 'ListItem',
          position: 2,
          name: categoryLabel,
          item: `${siteUrl}/${tool.category}`,
        },
        { '@type': 'ListItem', position: 3, name: tool.name, item: toolUrl },
      ],
    },
    ...(faq.length
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, a }) => ({
              '@type': 'Question',
              name: q,
              acceptedAnswer: { '@type': 'Answer', text: a },
            })),
          },
        ]
      : []),
  ],
};
---

<AppLayout
  title={`${tool.name} - ${siteName}`}
  description={`${tool.summary} Runs entirely in your browser, nothing is uploaded.`}
  activeCategory={tool.category}
>
  <Fragment slot="intro">
    <h1>{tool.name}</h1>
    <p>{tool.summary}</p>
  </Fragment>
  <ToolLoader toolId={tool.id} client:load />
  {faq.length > 0 && <ToolFaq faqs={faq} />}
</AppLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
