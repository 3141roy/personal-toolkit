---
import AppLayout from '../../layouts/AppLayout.astro';
import { byCategory } from '../../tools/registry';
import { categories, siteName } from '../../config/site';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const tools = byCategory(category.id);
---

<AppLayout title={`${category.label} tools - ${siteName}`} activeCategory={category.id}>
  <Fragment slot="intro">
    <h1>{category.label} tools</h1>
    <p>{tools.length} tool{tools.length !== 1 ? 's' : ''} in this category.</p>
  </Fragment>
  {tools.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <div class="tool-grid">
      {tools.map((tool) => (
        <a class="tool-card" href={`/${category.id}/${tool.id}`}>
          <div class="tool-name">{tool.name}</div>
          <div class="tool-desc">{tool.summary}</div>
        </a>
      ))}
    </div>
  )}
</AppLayout>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.1rem;
    margin-top: 1.5rem;
  }

  .tool-card {
    display: block;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: 2px 3px 0 rgba(42, 38, 32, 0.05);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    box-shadow: 3px 5px 0 rgba(42, 38, 32, 0.08);
  }

  .tool-name {
    font-family: var(--font-serif);
    font-size: var(--size-base);
    padding-bottom: 0.5rem;
    margin-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-line);
  }

  .tool-desc {
    font-size: var(--size-sm);
    color: var(--color-muted);
  }

  .empty {
    font-size: var(--size-sm);
    color: var(--color-muted);
    font-style: italic;
    margin-top: 1.5rem;
  }
</style>
