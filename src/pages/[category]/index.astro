---
import AppLayout from '../../layouts/AppLayout.astro';
import ToolGrid from '../../shell/ToolGrid.astro';
import { byCategory } from '../../tools/registry';
import { categories, siteName, siteUrl } from '../../config/site';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.id },
    props: { category },
  }));
}

const { category } = Astro.props;
const tools = byCategory(category.id);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: siteName, item: siteUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: category.label,
      item: `${siteUrl}/${category.id}`,
    },
  ],
};
---

<AppLayout
  title={`${category.label} tools - ${siteName}`}
  description={`Free ${category.label} tools that run entirely in your browser. Nothing is uploaded, nothing leaves your device.`}
  activeCategory={category.id}
>
  <Fragment slot="intro">
    <h1>{category.label} tools</h1>
    <p>
      {tools.length} tool{tools.length !== 1 ? 's' : ''} in this category.
    </p>
  </Fragment>
  {tools.length === 0 ? <p class="empty">Nothing here yet.</p> : <ToolGrid tools={tools} />}
</AppLayout>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<style>
  .empty {
    font-size: var(--size-sm);
    color: var(--color-muted);
    font-style: italic;
    margin-top: 1.5rem;
  }
</style>
