---
import AppLayout from '../layouts/AppLayout.astro';
import Stamp from '../shell/Stamp.svelte';
import CategoryDirectory from '../shell/CategoryDirectory.astro';
import { siteName } from '../config/site';

const usps = [
  {
    title: 'Nothing leaves your device',
    body: 'Files stay in this tab. A strict content security policy stops data going to other sites.',
  },
  {
    title: 'Free, no sign-up',
    body: 'No account, no ads, no watermarks, no paid tier.',
  },
  {
    title: 'Open source',
    body: 'MIT licensed. Read the code or run your own copy.',
  },
  {
    title: 'No upload wait',
    body: 'Nothing travels to a server, so big files start at once.',
  },
];
---

<AppLayout
  title={`Free Private Online Tools - PDF, Image, Dev & More | ${siteName}`}
  description="Free, open source PDF, image, developer, text and generator tools that run in your browser. No uploads, no sign-up, no ads. Nothing leaves your device."
>
  <header class="hero" slot="intro">
    <div class="hero-top">
      <h1>
        Tools that <span class="accent"
          >stay on your device<svg class="underline" viewBox="0 0 220 12" preserveAspectRatio="none"
            ><path d="M3 7 C 45 3, 80 10, 125 5 S 195 3, 217 7"></path></svg
          ></span
        >
      </h1>
      <div class="stamp-block">
        <Stamp />
        <span class="stamp-note">↖ every single one</span>
      </div>
    </div>
    <p class="sub">
      Free, open source PDF, image, developer, text and generator tools that run in your browser. No
      sign-up, no uploads.
    </p>
  </header>

  <div class="home-body">
    <section class="claims">
      {
        usps.map(({ title, body }) => (
          <div class="claim">
            <h2>{title}</h2>
            <p>{body}</p>
          </div>
        ))
      }
    </section>

    <CategoryDirectory />
  </div>
</AppLayout>

<style>
  .home-body {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 599px) {
    .claims {
      order: 1;
      margin-top: 0.5rem;
      border-top: 1px dashed var(--color-line);
    }

    .home-body :global(.directory-footer) {
      order: 2;
    }
  }

  .claims {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.4rem 0;
    border-bottom: 1px dashed var(--color-line);
  }

  .claim {
    padding: 1.1rem 0;
  }

  .claim + .claim {
    border-top: 1px dashed var(--color-line);
  }

  .claim h2 {
    margin: 0 0 0.3rem;
    font-family: var(--font-serif);
    font-size: var(--size-base);
    font-weight: 600;
    color: var(--color-ink);
  }

  .claim p {
    margin: 0;
    max-width: 34ch;
    font-size: var(--size-sm);
    line-height: 1.55;
    color: var(--color-muted);
  }

  @media (min-width: 600px) {
    .claims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .claim + .claim {
      border-top: 0;
    }

    .claim:nth-child(n + 3) {
      border-top: 1px dashed var(--color-line);
    }

    .claim:nth-child(odd) {
      padding-right: 1.5rem;
    }

    .claim:nth-child(even) {
      padding-left: 1.5rem;
      border-left: 1px dashed var(--color-line);
    }
  }

  @media (min-width: 1000px) {
    .claims {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .claim,
    .claim:nth-child(odd),
    .claim:nth-child(even) {
      padding: 1.1rem 1.5rem;
      border-top: 0;
      border-left: 1px dashed var(--color-line);
    }

    .claim:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .claim:last-child {
      padding-right: 0;
    }
  }

  .hero {
    padding-bottom: 2rem;
    border-bottom: 1px dashed var(--color-line);
    margin-bottom: 0.5rem;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 0.6rem;
  }

  .hero h1 {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    max-width: 32ch;
    margin: 0;
  }

  .hero h1 .accent {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--color-ink-navy);
  }

  .hero h1 .underline {
    position: absolute;
    left: 0;
    bottom: -0.28em;
    width: 100%;
    height: 0.4em;
    overflow: visible;
  }

  .hero h1 .underline path {
    stroke: var(--color-oxblood);
    stroke-width: 2.5;
    fill: none;
    stroke-linecap: round;
  }

  .stamp-block {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .stamp-note {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--color-oxblood);
    transform: rotate(2deg);
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .hero-top {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .stamp-note {
      display: none;
    }
  }

  .hero .sub {
    color: var(--color-muted);
    max-width: 52ch;
    font-size: var(--size-lg);
    margin-bottom: 0;
  }
</style>
