---
import AppLayout from '../layouts/AppLayout.astro';
import Stamp from '../shell/Stamp.svelte';
import CategoryDirectory from '../shell/CategoryDirectory.astro';
import { siteName } from '../config/site';
---

<AppLayout title={`Free PDF, Image & Dev Tools - Open Source, Private | ${siteName}`}>
  <header class="hero" slot="intro">
    <div class="hero-top">
      <h1>
        Tools that <span class="accent"
          >stay on your device<svg class="underline" viewBox="0 0 220 12" preserveAspectRatio="none"
            ><path d="M3 7 C 45 3, 80 10, 125 5 S 195 3, 217 7"></path></svg
          ></span
        >
      </h1>
      <div class="stamp-block">
        <Stamp />
        <span class="stamp-note">↖ every single one</span>
      </div>
    </div>
    <p class="sub">
      Free and open source, no sign-up. A personal project, built private, secure, and simple.
    </p>
  </header>

  <CategoryDirectory />
</AppLayout>

<style>
  .hero {
    padding-bottom: 2rem;
    border-bottom: 1px dashed var(--color-line);
    margin-bottom: 0.5rem;
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 0.6rem;
  }

  .hero h1 {
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    max-width: 32ch;
    margin: 0;
  }

  .hero h1 .accent {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--color-ink-navy);
  }

  .hero h1 .underline {
    position: absolute;
    left: 0;
    bottom: -0.28em;
    width: 100%;
    height: 0.4em;
    overflow: visible;
  }

  .hero h1 .underline path {
    stroke: var(--color-oxblood);
    stroke-width: 2.5;
    fill: none;
    stroke-linecap: round;
  }

  .stamp-block {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }

  .stamp-note {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    color: var(--color-oxblood);
    transform: rotate(2deg);
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .hero-top {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .stamp-note {
      display: none;
    }
  }

  .hero .sub {
    color: var(--color-muted);
    max-width: 52ch;
    font-size: var(--size-lg);
    margin-bottom: 0;
  }
</style>
