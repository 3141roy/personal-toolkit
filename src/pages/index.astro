---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../tools/registry';
---

<BaseLayout title="Ream">
	<h1>Ream</h1>
	<p>Found {tools.length} tool{tools.length !== 1 ? 's' : ''}:</p>
	<ul>
		{tools.map((tool) => (
			<li>{tool.name} ({tool.id})</li>
		))}
	</ul>
</BaseLayout>
