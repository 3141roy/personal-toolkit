---
import '../styles/tokens.css';
import '../styles/global.css';

import { siteName, siteUrl, siteDescription } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteName, description = siteDescription } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/og.png', siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline src="/theme-init.js"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1a16" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="desk">
      <div class="page">
        <div class="grain"></div>
        <div class="page-inner">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .desk {
    padding: 2.5rem 1.5rem;
  }

  .page {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    box-shadow: 5px 6px 0 rgba(42, 38, 32, 0.06);
    overflow: hidden;
  }

  .page-inner {
    position: relative;
    padding: 2.5rem 3rem 3rem;
  }

  @media (max-width: 720px) {
    .desk {
      padding: 0;
    }

    .page {
      max-width: 100%;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }

    .page-inner {
      padding: 1.5rem 1.25rem 2rem;
    }
  }
</style>
